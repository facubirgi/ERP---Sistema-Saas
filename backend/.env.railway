# ==========================================
# RAILWAY ENVIRONMENT CONFIGURATION
# ==========================================
# Estas variables usan la sintaxis de Railway para referencias de servicios
# ${{{ServiceName.VARIABLE}}} se reemplaza automáticamente por Railway

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=production
# PORT es inyectado automáticamente por Railway
# Railway lo asigna dinámicamente, no lo definas manualmente

# ==========================================
# DATABASE - PostgreSQL de Railway
# ==========================================
# IMPORTANTE: Asegúrate de tener un servicio PostgreSQL llamado "Postgres" en Railway
# Si tu servicio tiene otro nombre, reemplaza "Postgres" con el nombre correcto
DATABASE_HOST=${{{Postgres.PGHOST}}}
DATABASE_PORT=${{{Postgres.PGPORT}}}
DATABASE_USER=${{{Postgres.PGUSER}}}
DATABASE_PASSWORD=${{{Postgres.PGPASSWORD}}}
DATABASE_NAME=${{{Postgres.PGDATABASE}}}
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5

# ==========================================
# JWT CONFIGURATION
# ==========================================
# CRÍTICO: Genera secretos seguros para producción
# Usa: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# NO uses los mismos valores que en desarrollo
JWT_SECRET=${{{JWT_SECRET}}}
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=${{{JWT_REFRESH_SECRET}}}
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# CORS
# ==========================================
# IMPORTANTE: Reemplaza con la URL de tu frontend en Netlify
# Ejemplo: https://tu-app.netlify.app
# Para múltiples orígenes: https://app1.com,https://app2.com
CORS_ORIGIN=${{{CORS_ORIGIN}}}

# ==========================================
# BUSINESS CONFIGURATION
# ==========================================
MARGEN_MINIMO_PORCENTAJE=0
STOCK_BAJO_MULTIPLICADOR=1.0

# ==========================================
# PAGINATION
# ==========================================
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
